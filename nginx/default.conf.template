# La imagen oficial inserta las variables del entorno y los resolutores del contenedor.
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location ~ ^/api/(public/business|auth/(login|register|client/(login|me|pets(/[^/]+)?))|management/(session|contact|password|services(/[^/]+)?|clients(/[^/]+/pets(/[^/]+)?)?))$ {
        set $backend_url "${BACKEND_URL}";
        if ($backend_url = '') { return 503; }

        # Resuelve el DNS privado al recibir tráfico y admite direcciones IPv6.
        resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;
        resolver_timeout 5s;
        proxy_connect_timeout 5s;
        proxy_pass $backend_url$request_uri;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # React Router resuelve las rutas de aplicación también al recargar o abrir enlaces.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
